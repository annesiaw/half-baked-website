# Copy this file to .env and fill in real values (.env is gitignored).
# Without these set, announcements still work end-to-end but emails are
# logged as "skipped_no_provider" instead of actually being sent.

# Get this from https://resend.com after creating an account and an API key.
RESEND_API_KEY=

# Must be on a domain you've verified with Resend. Until you verify a
# domain, you can leave this unset to use Resend's shared test address
# (onboarding@resend.dev), which only delivers to your own account email.
CLUB_FROM_EMAIL=
CLUB_FROM_NAME=Half Baked Club
